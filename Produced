<pre class="wp-block-code"><code>from flask import Flask, request, jsonify
from woocommerce import API

app = Flask(__name__)

# WooCommerce API Configuration
wcapi = API(
    url=&#34;https://yourwebsite.com&#34;,
    consumer_key=&#34;ck_xxxxxxxxxxxxxxxxx&#34;,
    consumer_secret=&#34;cs_xxxxxxxxxxxxxxxxx&#34;,
    version=&#34;wc/v3&#34;
)

# =========================
# HOME ROUTE
# =========================
@app.route(&#39;/&#39;)
def home():
    return jsonify({
        &#34;message&#34;: &#34;Professional E-Commerce API Running&#34;
    })

# =========================
# GET ALL PRODUCTS
# =========================
@app.route(&#39;/products&#39;, methods=&#91;&#39;GET&#39;])
def get_products():
    products = wcapi.get(&#34;products&#34;).json()
    return jsonify(products)

# =========================
# ADD NEW PRODUCT
# =========================
@app.route(&#39;/add-product&#39;, methods=&#91;&#39;POST&#39;])
def add_product():
    data = request.json

    product_data = {
        &#34;name&#34;: data&#91;&#39;name&#39;],
        &#34;type&#34;: &#34;simple&#34;,
        &#34;regular_price&#34;: str(data&#91;&#39;price&#39;]),
        &#34;description&#34;: data&#91;&#39;description&#39;],
        &#34;short_description&#34;: data&#91;&#39;short_description&#39;],
        &#34;categories&#34;: &#91;
            {
                &#34;id&#34;: data&#91;&#39;category_id&#39;]
            }
        ]
    }

    result = wcapi.post(&#34;products&#34;, product_data).json()

    return jsonify(result)

# =========================
# UPDATE STOCK
# =========================
@app.route(&#39;/update-stock/&lt;int:product_id&gt;&#39;, methods=&#91;&#39;PUT&#39;])
def update_stock(product_id):
    data = request.json

    stock_data = {
        &#34;stock_quantity&#34;: data&#91;&#39;stock&#39;]
    }

    result = wcapi.put(f&#34;products/{product_id}&#34;, stock_data).json()

    return jsonify(result)

# =========================
# GET ORDERS
# =========================
@app.route(&#39;/orders&#39;, methods=&#91;&#39;GET&#39;])
def get_orders():
    orders = wcapi.get(&#34;orders&#34;).json()
    return jsonify(orders)

# =========================
# ORDER STATUS UPDATE
# =========================
@app.route(&#39;/update-order/&lt;int:order_id&gt;&#39;, methods=&#91;&#39;PUT&#39;])
def update_order(order_id):

    data = {
        &#34;status&#34;: &#34;completed&#34;
    }

    result = wcapi.put(f&#34;orders/{order_id}&#34;, data).json()

    return jsonify(result)

# =========================
# DELETE PRODUCT
# =========================
@app.route(&#39;/delete-product/&lt;int:product_id&gt;&#39;, methods=&#91;&#39;DELETE&#39;])
def delete_product(product_id):

    result = wcapi.delete(
        f&#34;products/{product_id}&#34;,
        params={&#34;force&#34;: True}
    ).json()

    return jsonify(result)

# =========================
# RUN SERVER
# =========================
if __name__ == &#39;__main__&#39;:
    app.run(debug=True)</code></pre>
